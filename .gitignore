# ============================================================
# CareerCompass AI
# Git Ignore
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example

# Streamlit secrets
.streamlit/secrets.toml

# Local databases
*.db
*.sqlite
*.sqlite3
data/careercompass.db

# Generated reports / exports
*.pdf
career-assessment-*.pdf

# Temporary files
*.tmp
*.temp
*.log

# IDE / editors
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Python tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
